{
  "name": "review-magnifier",
  "version": "4.0.0",
  "private": true,
  "description": "후기돋보기의 인터랙티브 제품 후기 프로토타입",
  "scripts": {
    "build": "node scripts/prepare-catalog.mjs && esbuild catalog.js --bundle --minify --format=iife --target=es2020 --outfile=catalog.bundle.js && node scripts/build-brand.mjs && python3 scripts/export.py && python3 scripts/build-pages.py",
    "check": "node --check catalog.js && node --check catalog-logic.mjs && node --check review-insights.js && node --check boot.js && node --check scripts/publication-policy.mjs && node --check scripts/prepare-catalog.mjs && node --check catalog.bundle.js",
    "preview": "python3 -m http.server 4187 --bind 127.0.0.1 --directory docs",
    "build:pages": "python3 scripts/build-pages.py",
    "db:init": "python3 scripts/data-pipeline.py init",
    "db:migrate": "python3 scripts/data-pipeline.py migrate",
    "db:stats": "python3 scripts/data-pipeline.py stats",
    "db:doctor": "python3 scripts/data-pipeline.py doctor",
    "db:backup": "python3 scripts/data-pipeline.py backup",
    "db:export": "python3 scripts/data-pipeline.py export --output .local-data/catalog-export.json",
    "data:plan": "python3 scripts/data-pipeline.py plan-naver",
    "data:collect": "python3 scripts/data-pipeline.py collect-naver",
    "data:rss": "python3 scripts/data-pipeline.py collect-rss",
    "data:products": "python3 scripts/data-pipeline.py collect-products",
    "test:data": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:ui": "node --test tests/*.test.mjs",
    "verify:release": "python3 scripts/verify-release.py",
    "verify:sources": "python3 scripts/verify-source-snapshots.py"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gradio/client": "2.7.2",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "sharp": "0.35.5"
  }
}
