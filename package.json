{
  "name": "review-magnifier",
  "version": "5.0.0",
  "private": true,
  "description": "제품별 쇼츠·영상·블로그 후기 탐색 서비스",
  "scripts": {
    "build": "node scripts/build-discovery.mjs",
    "check": "node --check discovery.js && node --check discovery-logic.mjs && node --check scripts/discovery-policy.mjs && node --check scripts/build-discovery.mjs && node --check scripts/reviews.mjs && node --check scripts/verify-discovery.mjs && node --check scripts/verify-discovery-sources.mjs",
    "preview": "python3 -m http.server 4187 --bind 127.0.0.1 --directory docs",
    "build:pages": "node scripts/build-discovery.mjs",
    "db:init": "python3 scripts/data-pipeline.py init",
    "db:migrate": "python3 scripts/data-pipeline.py migrate",
    "db:stats": "python3 scripts/data-pipeline.py stats",
    "db:doctor": "python3 scripts/data-pipeline.py doctor",
    "db:backup": "python3 scripts/data-pipeline.py backup",
    "db:export": "python3 scripts/data-pipeline.py export --output .local-data/catalog-export.json",
    "data:plan": "python3 scripts/data-pipeline.py plan-naver",
    "data:collect": "python3 scripts/data-pipeline.py collect-naver",
    "data:rss": "python3 scripts/data-pipeline.py collect-rss",
    "data:products": "python3 scripts/data-pipeline.py collect-products",
    "test:data": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:ui": "node --test tests/*.test.mjs",
    "verify:release": "node scripts/verify-discovery.mjs",
    "verify:sources": "node scripts/verify-discovery-sources.mjs",
    "reviews": "node scripts/reviews.mjs",
    "verify:legacy-sources": "python3 scripts/verify-source-snapshots.py"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gradio/client": "2.7.2",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "sharp": "0.35.5"
  }
}
